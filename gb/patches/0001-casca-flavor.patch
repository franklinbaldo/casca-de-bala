--- a/app/build.gradle
+++ b/app/build.gradle
@@ -184,6 +184,23 @@
             buildConfigField "boolean", "INTERNET_ACCESS", "true"
             // Note: app/src/banglejs/AndroidManifest.xml contains some extra permissions
         }
+
+        casca {
+            // Casca de Bala: Gadgetbridge plus an MCP hub (casca-de-bala/gb/overlay),
+            // published as the existing Casca app: same package, version from its CI.
+            dimension "device_type"
+            applicationId "org.workspace.band7.basicreader"
+            def cascaCode = providers.gradleProperty("cascaVersionCode").orElse("1").get()
+            if (!(cascaCode ==~ /[1-9][0-9]*/) || cascaCode.toBigInteger() > 2100000000)
+                throw new GradleException("Invalid cascaVersionCode")
+            versionCode cascaCode.toInteger()
+            versionName providers.gradleProperty("cascaVersionName").orElse("casca-dev").get()
+            ndk { abiFilters "arm64-v8a" }
+            proguardFiles "proguard-casca.pro"
+            // app/src/casca/AndroidManifest.xml adds INTERNET only for the MCP server
+            // (inbound, loopback/tailnet). INTERNET_ACCESS stays false: Gadgetbridge's
+            // own outbound access works as in mainline, through the Internet Helper.
+        }
     }
 
